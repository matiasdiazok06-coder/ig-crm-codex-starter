// Prisma schema (opcional) — ajustá a tu gusto
// npx prisma init (luego pegá este schema) y setea DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String   @id @default(cuid())
  igUserId        String   @unique
  username        String
  accessToken     String   // cifrado/encapsulado fuera del repo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations   Conversation[]
}

model Conversation {
  id            String   @id @default(cuid())
  account       Account  @relation(fields: [accountId], references: [id])
  accountId     String
  peerIgUserId  String
  lastMessageAt DateTime @default(now())

  messages      Message[]
  @@index([accountId, peerIgUserId])
}

model Message {
  id             String   @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      String   // 'in' | 'out'
  igMessageId    String   @unique
  text           String?
  createdAt      DateTime @default(now())

  @@index([igMessageId])
}
