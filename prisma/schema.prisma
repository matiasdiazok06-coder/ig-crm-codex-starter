// Prisma schema (opcional) — ajustá a tu gusto
// npx prisma init (luego pegá este schema) y setea DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OAuthToken {
  id        String   @id @default(cuid())
  account   Account? @relation(fields: [accountId], references: [id])
  accountId String?
  kind      OAuthTokenKind
  tokenEnc  String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id             String   @id @default(cuid())
  pageId         String
  pageName       String?
  igUserId       String   @unique
  username       String
  accessTokenEnc String
  connectedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations  Conversation[]
  tokens         OAuthToken[]
}

model Conversation {
  id                 String   @id @default(cuid())
  account            Account  @relation(fields: [accountId], references: [id])
  accountId          String
  peerIgUserId       String
  peerIgUsername     String?
  lastMessageAt      DateTime @default(now())
  lastMessageSnippet String?
  unreadCount        Int      @default(0)

  messages           Message[]
  @@unique([accountId, peerIgUserId])
}

model Message {
  id             String            @id @default(cuid())
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      MessageDirection
  igMessageId    String            @unique
  text           String?
  senderIgUserId String?
  createdAt      DateTime          @default(now())

  @@index([igMessageId])
}

enum OAuthTokenKind {
  user
  page
  ig
}

enum MessageDirection {
  in
  out
}
